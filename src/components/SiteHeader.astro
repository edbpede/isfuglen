---
import { createTranslator } from "../lib/i18n/index";
import { type PageKey, pathFor, siblingPath } from "../lib/i18n/routes";
import type { Lang } from "../lib/i18n/types";

/**
 * The logo is served from `public/brand/` rather than imported through
 * `astro:assets`. It has to exist at a stable runtime URL anyway: the preview
 * renderer takes a `logoSrc` string, and `scripts/build-logo-png.ts` reads the
 * same file to produce the DOCX raster. One copy, one path, no drift.
 */
const logoSrc = "/brand/ishoej-kreds18.svg";

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const t = createTranslator(lang);
const other: Lang = lang === "da" ? "en" : "da";

/**
 * Zero JavaScript. The language switch on a static page is two anchors to the
 * sibling route, and the preference is written by the destination page (§9.4).
 */
---

<header class="app-chrome flex items-center gap-4 border-b border-hairline bg-white px-4 py-3">
  <a
    href={pathFor(lang, "home")}
    class="flex items-center gap-3 text-brand no-underline focus-ring rounded-md"
  >
    <img src={logoSrc} alt="" width="300" height="100" class="h-7 w-auto" />
    <span class="font-serif text-base font-semibold">{t("app.title")}</span>
  </a>

  <nav class="ml-auto flex items-center gap-1" aria-label={t("nav.home")}>
    <a
      href={pathFor(lang, "help")}
      class="btn-ghost text-sm"
      aria-current={page === "help" ? "page" : undefined}>{t("nav.help")}</a
    >
    <a
      href={pathFor(lang, "privacy")}
      class="btn-ghost text-sm"
      aria-current={page === "privacy" ? "page" : undefined}>{t("nav.privacy")}</a
    >
    <a
      href={pathFor(lang, "about")}
      class="btn-ghost text-sm"
      aria-current={page === "about" ? "page" : undefined}>{t("nav.about")}</a
    >
  </nav>

  <div
    role="group"
    aria-label="Sprog / Language"
    class="flex overflow-hidden rounded-md border border-hairline"
  >
    <span class="bg-brand px-3 py-1 text-sm font-medium text-white" lang={lang} aria-current="true"
      >{lang === "da" ? "Dansk" : "English"}</span
    >
    <a
      href={siblingPath(lang, page)}
      hreflang={other}
      lang={other}
      class="bg-white px-3 py-1 text-sm font-medium text-brand no-underline hover:bg-surface-sunken focus-ring"
      >{other === "da" ? "Dansk" : "English"}</a
    >
  </div>
</header>
