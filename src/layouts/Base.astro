---
import sansFont from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import { createTranslator } from "../lib/i18n/index";
import type { Lang } from "../lib/i18n/types";
import "../styles/app.css";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Set on the workspace route, which is the only page that ships JavaScript. */
  bodyClass?: string;
}

const { lang, title, description, bodyClass = "" } = Astro.props;
const t = createTranslator(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#253154" />
    <meta name="color-scheme" content="light" />

    <!--
      The Content Security Policy is generated by Astro from `security.csp` in
      `astro.config.mjs`, which hashes the framework's own inline scripts. No
      backend, no analytics, no third-party origin; the Playwright privacy test
      fails on any request beyond the app's own static assets (docs/PLAN.md §16.4).
    -->

    <!--
      Preloading the two normal-weight latin faces closes the `font-display: swap`
      window. A swap mid-pagination makes Paged.js recompute and page breaks jump.
    -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={sansFont} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={serifFont} />
    <link rel="icon" href="/brand/ishoej-kreds18.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="da" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t("app.skipToContent")}</a>
    <slot />
  </body>
</html>
