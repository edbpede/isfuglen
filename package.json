{
  "name": "newsletter",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "description": "Nyhedsbrevsgenerator til faglig klub — paste meeting notes, get a laid-out A4 newsletter. Runs entirely in the browser.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "bun run scripts/build-logo-png.ts && astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "format": "biome check --write . && prettier --write --ignore-unknown .",
    "check:bundle": "bun run scripts/build-logo-png.ts && astro build && bun run scripts/check-bundle.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@nanostores/persistent": "1.3.5",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-bold": "3.30.1",
    "@tiptap/extension-document": "3.30.1",
    "@tiptap/extension-hard-break": "3.30.1",
    "@tiptap/extension-italic": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-list": "3.30.1",
    "@tiptap/extension-paragraph": "3.30.1",
    "@tiptap/extension-text": "3.30.1",
    "@tiptap/extensions": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@unocss/astro": "66.7.5",
    "astro": "7.2.2",
    "docx": "9.7.1",
    "idb-keyval": "6.3.0",
    "nanostores": "1.4.2",
    "pagedjs": "0.4.3",
    "svelte": "5.56.9",
    "unocss": "66.7.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.3.14",
    "axe-core": "4.13.0",
    "jszip": "3.10.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3"
  }
}
